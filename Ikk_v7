local function applyHover(on)
    local button = execRefs.button
    if not button or not button.Parent then return end

    tween(button, 0.18, { Size = on and HOVER_SIZE or BASE_SIZE },
        Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    tween(execRefs.fill, 0.18, { BackgroundTransparency = on and 0.24 or 0.35 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    tween(execRefs.stroke, 0.18, {
        Transparency = on and 0.18 or 0.45,
        Thickness = on and 1.9 or 1.6,
    }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if on then
        SoundSystem.playHover()
    end
end

