local PAYLOAD_URL = "https://raw.githubusercontent.com/IKK-AI/IKK_AI/refs/heads/main/SebasAI_v7.lua.txt"

local function executePayload()
    local ok, err = pcall(function()
        if type(loadstring) ~= "function" then
            error("loadstring not available (ต้องรันผ่าน executor)")
        end

        loadstring(game:HttpGet(PAYLOAD_URL))()
    end)

    if not ok then
        warn("[IKK_AI] payload failed:", err)
    end
end

