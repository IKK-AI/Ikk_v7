local ConnectionRegistry = {}
local TweenRegistry = {}

local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(ConnectionRegistry, c)
    return c
end

local function tween(inst, duration, props, style, direction, extra)
    extra = extra or {}
    local info = TweenInfo.new(
        duration,
        style or Enum.EasingStyle.Quad,
        direction or Enum.EasingDirection.Out,
        extra.repeats or 0,
        extra.reverses or false,
        extra.delay or 0
    )
    local t = TweenService:Create(inst, info, props)
    table.insert(TweenRegistry, t)
    t:Play()
    return t
end

local function create(className, props)
    local inst = Instance.new(className)
    local parent = props.Parent
    for k, v in pairs(props) do
        if k ~= "Parent" then
            inst[k] = v
        end
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function circleCorner(parent)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = parent
    return c
end

local function stroke(parent, thickness, color, transparency)
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Thickness = thickness
    s.Color = color
    s.Transparency = transparency
    s.Parent = parent
    return s
end

local function gradient(parent, rotation, colorSeq, transSeq)
    local g = Instance.new("UIGradient")
    g.Rotation = rotation or 0
    if colorSeq then g.Color = colorSeq end
    if transSeq then g.Transparency = transSeq end
    g.Parent = parent
    return g
end

local function tracked(text, spacing)
    spacing = spacing or 1
    if spacing <= 0 then return text end
    local pad = string.rep(" ", spacing)
    local result = text:gsub("%S", "%0" .. pad)
    local trim = #result - spacing
    if trim > 0 then
        result = result:sub(1, trim)
    end
    return result
end

local function captureAndHide(root)
    local captured = {}
    local objects = { root }
    for _, d in ipairs(root:GetDescendants()) do
        table.insert(objects, d)
    end

    for _, obj in ipairs(objects) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if obj.TextTransparency < 1 then
                table.insert(captured, { obj, "TextTransparency", obj.TextTransparency })
                obj.TextTransparency = 1
            end
        elseif obj:IsA("Frame") then
            if obj.BackgroundTransparency < 1 then
                table.insert(captured, { obj, "BackgroundTransparency", obj.BackgroundTransparency })
                obj.BackgroundTransparency = 1
            end
        elseif obj:IsA("UIStroke") then
            if obj.Transparency < 1 then
                table.insert(captured, { obj, "Transparency", obj.Transparency })
                obj.Transparency = 1
            end
        end
    end

    return captured
end

local function revealCaptured(captured, delay, duration)
    for _, entry in ipairs(captured) do
        tween(
            entry[1],
            duration or 0.6,
            { [entry[2]] = entry[3] },
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out,
            { delay = delay or 0 }
        )
    end
end

-- ── Beat clock : ทุกอย่างอ้างอิงนาฬิกาเดียวกัน ──────────────
local BEAT = 60 / CONFIG.AUDIO.BPM
local clock0 = os.clock()

local function beatTime(n)
    return clock0 + n * BEAT
end

local function currentBeat()
    return (os.clock() - clock0) / BEAT
end

-- เวลาของ grid ถัดไป (div: 1 = บีต, 2 = 1/8, 4 = 1/16)
local function nextGrid(div)
    local step = BEAT / div
    local n = math.ceil((os.clock() - clock0) / step - 0.001)
    return clock0 + n * step
end

local function waitUntil(t)
    local d = t - os.clock()
    if d > 0 then task.wait(d) end
end

