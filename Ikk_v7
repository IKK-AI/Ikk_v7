        table.insert(items, { name = "blip", speed = NOTE.sixth, vol = 1.0, beat = 0.5 })
        table.insert(items, { name = "blip", speed = NOTE.oct,   vol = 1.0, beat = 1.0 })
    end
    SoundSystem.stack(items, at)
end

