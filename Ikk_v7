-- แต่ละขั้นเริ่มพอดีบีต เสียงและภาพลงพร้อมกัน
local function runStatusPlan()
    local cursor = math.ceil(currentBeat() - 0.02)

    for i, step in ipairs(STATUS_PLAN) do
        waitUntil(beatTime(cursor))

        SoundSystem.cues.status(i, beatTime(cursor))

        local label = loaderRefs.statusLabel
        tween(label, 0.1, { TextTransparency = 1 },
            Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.1, function()
            if label and label.Parent then
                label.Text = tracked(step.text, 1)
                tween(label, 0.16, { TextTransparency = 0 },
                    Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            end
        end)

        tween(progressValue, step.beats * BEAT * 0.92, { Value = step.to },
            Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

        cursor += step.beats
    end

    waitUntil(beatTime(cursor))
end

local function destroyLoader()
    spinnerActive = false

    if spinnerConn then
        spinnerConn:Disconnect()
    end

    if loaderRefs.screen then
        loaderRefs.screen:Destroy()
    end

    loaderRefs = {}
end

local function fadeGuiOut(duration)
    if bgRefs.oceanGlowTween then
        bgRefs.oceanGlowTween:Cancel()
    end

    if bgRefs.oceanGlow then
        tween(bgRefs.oceanGlow, duration, { BackgroundTransparency = 1 },
            Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    end

    if bgRefs.background then
        tween(bgRefs.background, duration, { BackgroundTransparency = 1 },
            Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    end

    if sceneRefs.viewport then
        tween(sceneRefs.viewport, duration, { ImageTransparency = 1 },
            Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    end
end


