local function newPart(props)
    local p = {
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        CanTouch = false,
        CastShadow = false,
        Material = Enum.Material.Neon,
        TopSurface = Enum.SurfaceType.Smooth,
        BottomSurface = Enum.SurfaceType.Smooth,
    }
    for k, v in pairs(props) do p[k] = v end
    return create("Part", p)
end

local function buildRing(radius, segs, thick, color, parent)
    local model = Instance.new("Model")
    local pivot = newPart({
        Name = "Pivot", Size = Vector3.new(0.05, 0.05, 0.05),
        Transparency = 1, Parent = model,
    })
    model.PrimaryPart = pivot

    local segLen = 2 * math.pi * radius / segs * 0.92
    for i = 1, segs do
        local a = (i - 1) / segs * math.pi * 2
        local cf = CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0)
            * CFrame.Angles(0, 0, a + math.pi / 2)
        newPart({
            Size = Vector3.new(segLen, thick, thick),
            CFrame = cf,
            Color = (i % 5 == 0) and THEME.WHITE or color,
            Parent = model,
        })
    end

    model.Parent = parent
    return model
end

local function buildCube(edge, thick, color, parent)
    local model = Instance.new("Model")
    local pivot = newPart({
        Name = "Pivot", Size = Vector3.new(0.05, 0.05, 0.05),
        Transparency = 1, Parent = model,
    })
    model.PrimaryPart = pivot

    local h = edge / 2
    for _, sa in ipairs({ -1, 1 }) do
        for _, sb in ipairs({ -1, 1 }) do
            newPart({ Size = Vector3.new(edge + thick, thick, thick),
                CFrame = CFrame.new(0, sa * h, sb * h), Color = color, Parent = model })
            newPart({ Size = Vector3.new(thick, edge + thick, thick),
                CFrame = CFrame.new(sa * h, 0, sb * h), Color = color, Parent = model })
            newPart({ Size = Vector3.new(thick, thick, edge + thick),
                CFrame = CFrame.new(sa * h, sb * h, 0), Color = color, Parent = model })
        end
    end

    model.Parent = parent
    return model
end

local function buildScene()
    local camera = Workspace.CurrentCamera
    local vpSize = camera and camera.ViewportSize or Vector2.new(1280, 720)
    local dist0 = CONFIG.SCENE.CAM_DIST
    local fov0 = CONFIG.SCENE.FOV

    -- คำนวณขนาดโลก 3D ให้แกนพอดีกับวง HUD (ไม่ขึ้นกับขนาดจอ)
    local visH = 2 * dist0 * math.tan(math.rad(fov0 / 2))
    local visW = visH * (vpSize.X / vpSize.Y)
    local pxPerUnit = vpSize.Y / visH
    local S = (CONFIG.LOADING.RING_SIZE - 26) / pxPerUnit

    local viewport = create("ViewportFrame", {
        Name = "Scene3D",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ImageTransparency = 1,
        ZIndex = 3,
        Ambient = Color3.fromRGB(90, 130, 150),
        LightColor = Color3.fromRGB(210, 245, 255),
        LightDirection = Vector3.new(-1, -1.2, -0.8),
        Parent = screenGui,
    })

    local vcam = Instance.new("Camera")
    vcam.FieldOfView = fov0
    vcam.Parent = viewport
    viewport.CurrentCamera = vcam

    local world = Instance.new("Model")
    world.Name = "World"
    world.Parent = viewport

    -- proxies สำหรับ tween
    local proxies = create("Folder", { Name = "Proxies", Parent = screenGui })
    local function num(name, v)
        return create("NumberValue", { Name = name, Value = v, Parent = proxies })
    end
    local spin = num("Spin", 1.0)
    local camDist = num("CamDist", dist0)
    local fovV = num("Fov", fov0)
    local coreY = num("CoreY", LAYOUT.RING_Y)

    -- ── แกนกลาง ────────────────────────────────────────────
    local sphereBase = S * 0.20
    local shellBase = S * 0.34

    local sphere = newPart({
        Shape = Enum.PartType.Ball,
        Size = Vector3.one * sphereBase,
        Color = THEME.CYAN, Parent = world,
    })
    local shell = newPart({
        Shape = Enum.PartType.Ball,
        Size = Vector3.one * shellBase,
        Material = Enum.Material.SmoothPlastic,
        Transparency = 0.78, Color = THEME.CYAN, Parent = world,
    })

    local thick = S * 0.02
    local ring1 = buildRing(S * 0.36, 28, thick, THEME.CYAN, world)
    local ring2 = buildRing(S * 0.43, 32, thick, THEME.TEAL, world)
    local ring3 = buildRing(S * 0.50, 36, thick, THEME.CYAN, world)
    local cube = buildCube(S * 0.22, thick * 0.9, THEME.TEAL, world)

    -- ── พาทิเคิลโคจร ───────────────────────────────────────
    local orbiters = {}
    for i = 1, CONFIG.SCENE.ORBIT_PARTICLES do
        local sz = S * (0.012 + math.random() * 0.022)
        local color = (i % 7 == 0) and THEME.WHITE
            or ((i % 2 == 0) and THEME.CYAN or THEME.TEAL)
        local part = newPart({
            Shape = Enum.PartType.Ball,
            Size = Vector3.one * sz,
            Color = color, Parent = world,
        })
        orbiters[i] = {
            part = part,
            r = S * (0.62 + math.random() * 1.5),
            ang = math.random() * math.pi * 2,
            speed = (0.35 + math.random() * 0.9) * (math.random(2) == 1 and 1 or -1),
            tilt = CFrame.Angles(math.random() * math.pi, math.random() * math.pi, 0),
            tw = 1.5 + math.random() * 3,
            ph = math.random() * 6.28,
        }
    end

    -- ── ฝุ่นลอยหลายชั้นความลึก ────────────────────────────
    local dust = {}
    for i = 1, CONFIG.SCENE.DUST do
        local sz = 0.015 + math.random() * 0.035
        local pos = Vector3.new(
            (math.random() - 0.5) * visW * 1.4,
            (math.random() - 0.5) * visH * 1.5,
            -8 + math.random() * 11
        )
        local part = newPart({
            Shape = Enum.PartType.Ball,
            Size = Vector3.one * sz,
            Color = (i % 2 == 0) and THEME.CYAN or THEME.TEAL,
            Transparency = 0.5 + math.random() * 0.35,
            CFrame = CFrame.new(pos), Parent = world,
        })
        dust[i] = { part = part, pos = pos, v = 0.12 + math.random() * 0.35 }
    end

    local shards, streaks, waves = {}, {}, {}

    local state = {
        nx = 0, ny = 0, tx = 0, ty = 0,
        pulse = 0, shake = 0, angle = 0,
        t0 = os.clock(),
    }

    -- pointer / touch parallax
    connect(UserInputService.InputChanged, function(input)
        local ut = input.UserInputType
        if ut == Enum.UserInputType.MouseMovement or ut == Enum.UserInputType.Touch then
            local cam = Workspace.CurrentCamera
            local sz = cam and cam.ViewportSize or vpSize
            state.tx = math.clamp((input.Position.X / sz.X - 0.5) * 2, -1, 1)
            state.ty = math.clamp((input.Position.Y / sz.Y - 0.5) * 2, -1, 1)
        end
    end)

    local function centerNow()
        return Vector3.new(0, (0.5 - coreY.Value) * visH, 0)
    end

    -- shockwave วงแหวน 3D
    local function spawnWave(center)
        local m = buildRing(S * 0.5, 36, S * 0.03, THEME.CYAN, world)
        m:PivotTo(CFrame.new(center))
        local parts = {}
        for _, d in ipairs(m:GetChildren()) do
            if d:IsA("BasePart") and d.Name ~= "Pivot" then
                table.insert(parts, d)
            end
        end
        table.insert(waves, { model = m, parts = parts, age = 0, dur = 0.8 })
    end

    local lastBeat = -1

    local function update(dt)
        if not viewport.Parent then return end

        local now = os.clock()
        local t = now - state.t0

        -- beat detection : ทั้งภาพและเสียงใช้นาฬิกาเดียวกัน
        local beatIdx = math.floor((now - clock0) / BEAT)
        if beatIdx ~= lastBeat then
            lastBeat = beatIdx
            state.pulse = 1
            SoundSystem.onBeat(beatIdx)
        end

        -- smoothing + idle sway (มีมิติเสมอแม้ไม่ได้ขยับเมาส์)
        local gx = state.tx * 0.7 + math.sin(t * 0.7) * 0.25
        local gy = state.ty * 0.7 + math.cos(t * 0.53) * 0.18
        local k = 1 - math.exp(-6 * dt)
        state.nx += (gx - state.nx) * k
        state.ny += (gy - state.ny) * k

        state.pulse = math.max(0, state.pulse - dt * 3.4)
        state.shake = math.max(0, state.shake - dt * 2.6)
        state.angle += dt * spin.Value

        local a = state.angle
        local p = state.pulse * state.pulse
        local center = centerNow()
        local sceneCF = CFrame.new(center)
            * CFrame.Angles(state.ny * 0.35, state.nx * 0.55, 0)

        -- core
        sphere.CFrame = sceneCF
        sphere.Size = Vector3.one * (sphereBase * (1 + 0.35 * p))
        sphere.Color = THEME.CYAN:Lerp(THEME.WHITE, p * 0.7)

        shell.CFrame = sceneCF * CFrame.Angles(a * 0.3, a * 0.2, 0)
        shell.Size = Vector3.one * (shellBase * (1 + 0.18 * p))
        shell.Transparency = 0.78 - p * 0.2

        ring1:PivotTo(sceneCF * CFrame.Angles(0, a * 1.0, a * 0.35))
        ring2:PivotTo(sceneCF * CFrame.Angles(math.rad(60) + a * 0.5, -a * 0.8, 0))
        ring3:PivotTo(sceneCF * CFrame.Angles(math.rad(-50), a * 0.6, -a * 0.9))
        cube:PivotTo(sceneCF * CFrame.Angles(a * 0.7, a * 1.1, a * 0.3))

        -- orbiters
        local sp = 0.6 + spin.Value * 0.4
        for _, o in ipairs(orbiters) do
            o.ang += dt * o.speed * sp
            local pos = o.tilt * Vector3.new(math.cos(o.ang) * o.r, 0, math.sin(o.ang) * o.r)
            o.part.CFrame = sceneCF * CFrame.new(pos)
            o.part.Transparency = 0.12 + 0.55 * (0.5 + 0.5 * math.sin(t * o.tw + o.ph))
        end

        -- dust
        for _, d in ipairs(dust) do
            d.pos += Vector3.new(0, d.v * dt, 0)
            if d.pos.Y > visH * 0.75 then
                d.pos = Vector3.new(d.pos.X, -visH * 0.75, d.pos.Z)
            end
            d.part.CFrame = CFrame.new(d.pos)
        end

        -- camera (parallax + shake + dolly)
        local cd = camDist.Value
        local amt = visW * 0.018
        local sh = state.shake * 0.12
        local camPos = Vector3.new(
            -state.nx * amt + (math.random() - 0.5) * sh,
            state.ny * amt + (math.random() - 0.5) * sh,
            cd
        )
        vcam.CFrame = CFrame.lookAt(camPos, Vector3.zero)
        vcam.FieldOfView = fovV.Value

        -- shards
        local i = 1
        while i <= #shards do
            local s = shards[i]
            s.age += dt
            if s.age >= s.life then
                s.part:Destroy()
                shards[i] = shards[#shards]
                shards[#shards] = nil
            else
                s.vel *= (1 - dt * 1.8)
                s.pos += s.vel * dt
                s.part.CFrame = CFrame.lookAt(s.pos, s.pos + s.vel + Vector3.new(0, 0, 1e-4))
                s.part.Transparency = (s.age / s.life) ^ 2
                i += 1
            end
        end

        -- warp streaks (พุ่งเข้าหากล้อง)
        i = 1
        while i <= #streaks do
            local s = streaks[i]
            s.z += s.speed * dt
            if s.z - s.len / 2 > cd then
                s.part:Destroy()
                streaks[i] = streaks[#streaks]
                streaks[#streaks] = nil
            else
                s.part.CFrame = CFrame.new(s.x, s.y, s.z)
                s.part.Transparency = 0.85 - math.clamp((s.z + 28) / 14, 0, 1) * 0.7
                i += 1
            end
        end

        -- shockwaves
        i = 1
        while i <= #waves do
            local w = waves[i]
            w.age += dt
            local e = w.age / w.dur
            if e >= 1 then
                w.model:Destroy()
                waves[i] = waves[#waves]
                waves[#waves] = nil
            else
                pcall(function() w.model:ScaleTo(0.2 + e * 16) end)
                local tr = 0.15 + 0.85 * e
                for _, part in ipairs(w.parts) do
                    part.Transparency = tr
                end
                i += 1
            end
        end

        -- parallax พื้นหลัง 2D
        if bgRefs.oceanGlow and bgRefs.oceanGlow.Parent then
            bgRefs.oceanGlow.Position = UDim2.fromScale(0.5 + state.nx * 0.015, 1.08)
        end
    end

    connect(RunService.Heartbeat, update)

    -- ── API ────────────────────────────────────────────────
    local api = {
        viewport = viewport,
        spin = spin, camDist = camDist, fov = fovV, coreY = coreY,
        state = state,
    }

    function api.burst()
        state.pulse = 1
        state.shake = 1
        local c = centerNow()

        for n = 1, CONFIG.SCENE.BURST_SHARDS do
            local dir = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
            if dir.Magnitude < 0.05 then dir = Vector3.new(0, 1, 0) end
            dir = dir.Unit

            local color = (n % 3 == 0) and THEME.WHITE
                or ((n % 2 == 0) and THEME.CYAN or THEME.TEAL)
            local len = S * (0.05 + math.random() * 0.14)
            local part = newPart({
                Size = Vector3.new(S * 0.02, S * 0.02, len),
                Color = color, CFrame = CFrame.new(c), Parent = world,
            })
            table.insert(shards, {
                part = part, pos = c,
                vel = dir * S * (3 + math.random() * 9),
                age = 0, life = 0.7 + math.random() * 0.6,
            })
        end

        for w = 1, 3 do
            task.delay((w - 1) * 0.07, function()
                if world.Parent then spawnWave(c) end
            end)
        end
    end

    function api.warp()
        for _ = 1, CONFIG.SCENE.WARP_STREAKS do
            task.delay(math.random() * 0.5, function()
                if not world.Parent then return end
                local ang = math.random() * math.pi * 2
                local rad = visW * (0.05 + math.random() * 0.5)
                local len = 3 + math.random() * 6
                local x, y = math.cos(ang) * rad, math.sin(ang) * rad
                local part = newPart({
                    Size = Vector3.new(0.025, 0.025, len),
                    Color = (math.random(2) == 1) and THEME.CYAN or THEME.WHITE,
                    Transparency = 0.85,
                    CFrame = CFrame.new(x, y, -28), Parent = world,
                })
                table.insert(streaks, {
                    part = part, x = x, y = y, z = -28, len = len,
                    speed = 45 + math.random() * 45,
                })
            end)
        end
    end

    return api
end


