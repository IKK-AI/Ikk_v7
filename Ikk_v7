-- scale = ตัวคูณจาก volume พื้นฐาน (default 1)
function SoundSystem.play(name, speed, scale)
    local preset = SOUND_PRESETS[name]
    if not preset then return end

    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = preset.id
        s.Volume = preset.volume * (scale or 1)
        s.PlaybackSpeed = speed or 1
        s.SoundGroup = masterGroup
        s.Parent = soundFolder
        s.Ended:Connect(function() s:Destroy() end)
        s:Play()
        Debris:AddItem(s, 10)
    end)
end

-- items: { name, speed, vol, beat = เลื่อนกี่บีต, sec = เลื่อนกี่วินาที }
-- startAt: เวลา absolute (os.clock) ที่ถือเป็นบีต 0 ของคิวนี้
function SoundSystem.stack(items, startAt)
    startAt = startAt or os.clock()
    for _, it in ipairs(items) do
        local at = startAt + (it.beat or 0) * BEAT + (it.sec or 0)
        local d = at - os.clock()
        if d <= 0.004 then
            SoundSystem.play(it.name, it.speed, it.vol)
        else
            task.delay(d, function()
                SoundSystem.play(it.name, it.speed, it.vol)
            end)
        end
    end
end

