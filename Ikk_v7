-- Rhythm เบา ๆ : kick ทุกบีต 1 และ 3 / hat ที่ off-beat
function SoundSystem.onBeat(b)
    if not rhythmOn or not CONFIG.AUDIO.RHYTHM then return end

    local pos = b % 4
    if pos == 0 then
        SoundSystem.play("pulse", 0.70, 0.45)
    elseif pos == 2 then
        SoundSystem.play("pulse", 0.85, 0.30)
    end

    task.delay(BEAT / 2, function()
        if rhythmOn then
            SoundSystem.play("static", 2.2, 0.30)
        end
    end)
end

local function hapticPulse()
    pcall(function()
        for i = 1, 4 do
            local gamepadType = Enum.UserInputType["Gamepad" .. i]
            if HapticService:IsVibrationSupported(gamepadType) then
                HapticService:SetMotor(gamepadType, Enum.VibrationMotor.Large, 0.55)
                task.delay(0.16, function()
                    pcall(function()
                        HapticService:SetMotor(gamepadType, Enum.VibrationMotor.Large, 0)
                    end)
                end)
            end
        end
    end)
end


