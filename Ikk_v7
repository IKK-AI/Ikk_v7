local function fovPunch()
    pcall(function()
        local cam = Workspace.CurrentCamera
        if not cam then return end

        if not savedFieldOfView then
            savedFieldOfView = cam.FieldOfView
        end

        fovRestoreUntil = os.clock() + 1.2

        tween(cam, 0.18, { FieldOfView = savedFieldOfView + 7 },
            Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        tween(cam, 0.45, { FieldOfView = savedFieldOfView },
            Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, { delay = 0.25 })
    end)
end


