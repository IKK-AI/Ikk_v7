-- Timeline (นับจาก T0 = จังหวะ 1/8 ถัดไปหลังกด):
--   0b    Charge เริ่ม (riser 2 บีต, แกน 3D หมุนเร็วขึ้น + กล้องพุ่งเข้า)
--   1.5b  UI ปุ่มค่อย ๆ หาย
--   2b    IMPACT (burst เสียง + 3D shards/shockwave/warp + 2D FX)
--   2.5b  เฟด GUI + แกน 3D (1.5 บีต)
--   4b    รัน payload + success cue
--   5.5b  เก็บกวาด
function startExecuteSequence()
    if executing or not execScreenActive then return end

    executing = true
    dotsActive = true
    execScreenActive = false
    rhythmOn = false

    local T0 = nextGrid(2)
    waitUntil(T0)

    SoundSystem.cues.charge(T0)

    local button = execRefs.button
    local buttonStroke = execRefs.stroke
    local label = execRefs.label
    local fill = execRefs.fill
    local chargeDur = BEAT * 2

    label.Text = "INITIALIZING"

    tween(button, chargeDur, { Size = CHARGE_SIZE },
        Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    tween(fill, chargeDur, { BackgroundTransparency = 0.2 },
        Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    tween(buttonStroke, chargeDur, { Transparency = 0.05, Thickness = 2.6 },
        Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

    -- 3D: หมุนเร็วขึ้น, ดึงแกนเข้ากลางจอ, กล้องพุ่งเข้าหา
    if sceneRefs.spin then
        tween(sceneRefs.spin, chargeDur, { Value = 9 },
            Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween(sceneRefs.coreY, chargeDur, { Value = 0.5 },
            Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        tween(sceneRefs.camDist, chargeDur, { Value = 4.6 },
            Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    end

    task.spawn(function()
        local pattern = { "", ".", "..", "..." }
        local idx = 0
        while dotsActive and button.Parent do
            idx = idx % #pattern + 1
            label.Text = "INITIALIZING" .. pattern[idx]
            task.wait(BEAT / 2)
        end
    end)

    -- UI ปุ่มหาย ก่อน impact ครึ่งบีต
    waitUntil(T0 + BEAT * 1.5)
    dotsActive = false

    tween(fill, 0.35, { BackgroundTransparency = 1 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(label, 0.35, { TextTransparency = 1 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(buttonStroke, 0.35, { Transparency = 1 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    for _, el in ipairs({
        execRefs.topDot, execRefs.topLabel, execRefs.sub,
        execRefs.footer, execRefs.highlight,
    }) do
        if el:IsA("TextLabel") then
            tween(el, 0.35, { TextTransparency = 1 },
                Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        else
            tween(el, 0.35, { BackgroundTransparency = 1 },
                Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        end
    end

    Debris:AddItem(button, 0.5)

    -- ══ IMPACT (ลงบีตพอดี) ══
    waitUntil(T0 + BEAT * 2)

    SoundSystem.cues.burst(T0 + BEAT * 2)

    spawnEnergyRings()
    spawnRadialGlow()
    spawnScanLines()
    spawnParticleBurst()
    spawnMotionBlur()
    spawnWipe()
    fovPunch()

    if sceneRefs.burst then
        sceneRefs.burst()
        sceneRefs.warp()

        -- กล้องถอยกลับ (recoil) + FOV กระชาก
        tween(sceneRefs.camDist, BEAT * 1.2, { Value = 7.5 },
            Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        tween(sceneRefs.fov, 0.12, { Value = CONFIG.SCENE.FOV + 22 },
            Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        tween(sceneRefs.fov, BEAT * 1.4, { Value = CONFIG.SCENE.FOV },
            Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { delay = 0.12 })
    end

    waitUntil(T0 + BEAT * 2.5)
    fadeGuiOut(BEAT * 1.5)

    waitUntil(T0 + BEAT * 4)

    local ok, err = pcall(executePayload)
    if not ok then
        warn("[IKK_AI] executePayload() error:", err)
    end

    SoundSystem.cues.success(T0 + BEAT * 4)

    waitUntil(T0 + BEAT * 5.5)

    shutdownSystem()
end


