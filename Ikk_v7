    spinnerConn = connect(RunService.Heartbeat, function()
        if not spinnerActive then return end

        local t = (currentBeat() / 2) % 1
        local head = t * segCount

        for i, seg in ipairs(segments) do
            local d = (head - (i - 1)) % segCount
            seg.BackgroundTransparency = 0.06 + (d / segCount) * 0.86
        end
    end)

