-- MODULE 10 : CLEANUP SYSTEM
-- ═══════════════════════════════════════════════════════════

local cleaned = false

function shutdownSystem()
    if cleaned then return end
    cleaned = true
    rhythmOn = false

    pcall(function()
        for _, c in ipairs(ConnectionRegistry) do
            c:Disconnect()
        end
    end)

    pcall(function()
        for _, t in ipairs(TweenRegistry) do
            t:Cancel()
        end
    end)

    pcall(function()
        if savedFieldOfView
            and os.clock() < fovRestoreUntil
            and Workspace.CurrentCamera then
            Workspace.CurrentCamera.FieldOfView = savedFieldOfView
        end
    end)

    pcall(function()
        if screenGui then
            screenGui:Destroy()
        end
    end)

    pcall(function()
        Debris:AddItem(soundFolder, 6)
    end)
end

pcall(function()
    if getgenv then
        getgenv().IKK_AI_V8 = { shutdown = shutdownSystem }
    end
end)


