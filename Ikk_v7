-- ENTRY POINT : BOOT SEQUENCE
-- ═══════════════════════════════════════════════════════════

local function boot()
    local prev = uiParent:FindFirstChild(CONFIG.UI_NAME)
    if prev then
        prev:Destroy()
    end

    screenGui = create("ScreenGui", {
        Name = CONFIG.UI_NAME,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = uiParent,
    })

    connect(screenGui.Destroying, shutdownSystem)

    buildBackground()
    sceneRefs = buildScene()
    buildLoader()

    -- เริ่มนาฬิกาบีต ณ จุดนี้ : บีต 0 = เสียง boot
    clock0 = os.clock()
    sceneRefs.state.t0 = clock0
    rhythmOn = true

    SoundSystem.cues.boot(clock0)

    tween(cover, 0.85, { BackgroundTransparency = 1 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { delay = 0.12 })

    tween(loaderRefs.titleContainer, 0.8,
        { Position = UDim2.fromScale(0.5, LAYOUT.TITLE_Y) },
        Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { delay = 0.3 })

    tween(sceneRefs.viewport, 0.9, { ImageTransparency = 0 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { delay = 0.3 })

    revealCaptured(loaderRefs.captured, 0.35, 0.65)

    -- Intro 2 บีต แล้ว status แรกเริ่มที่บีต 2
    waitUntil(beatTime(2))

    spinnerActive = true

    task.delay(0.2, function()
        if loaderRefs.screen then
            for _ = 1, CONFIG.LOADING.DRIFT_PARTICLES do
                spawnDriftParticle(loaderRefs.screen)
            end
        end
    end)

    runStatusPlan()

    spinnerActive = false

    for _, seg in ipairs(loaderRefs.segments) do
        tween(seg, 0.35, { BackgroundTransparency = 0.12 })
    end

    loaderRefs.statusLabel.TextColor3 = THEME.TEAL

    SoundSystem.cues.transition(os.clock())

    -- ค้าง READY 1 บีต แล้วเปลี่ยนฉาก
    task.wait(BEAT)

    tween(cover, BEAT / 2, { BackgroundTransparency = 0 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    task.wait(BEAT / 2 + 0.02)

    destroyLoader()
    buildExecuteScreen()

    -- แกน 3D เลื่อนขึ้นไปอยู่เหนือปุ่ม START
    tween(sceneRefs.coreY, BEAT * 2, { Value = LAYOUT.CORE_READY_Y },
        Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    tween(cover, BEAT, { BackgroundTransparency = 1 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { delay = 0.1 })

    execScreenActive = true
end

task.spawn(function()
    local ok, err = pcall(boot)

    if not ok then
        warn("[IKK_AI] boot failed:", err)
        shutdownSystem()
    end
end)
